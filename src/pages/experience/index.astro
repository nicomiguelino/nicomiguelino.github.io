---
import { SITE_NAME } from '@/lib/site';
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
import Screenly from '@/components/experience/Screenly.astro';
import DostAstiBackend from '@/components/experience/DostAstiBackend.astro';
import Nokia from '@/components/experience/Nokia.astro';
import DostAstiTestAutomation from '@/components/experience/DostAstiTestAutomation.astro';

const description = 'My tech journey so far...';
---

<Layout title=`Experience — ${SITE_NAME}` description={description} canonicalPath="/experience/">
  <main class="content-shell">
    <PageHero title="Experience" hideTitle>
      <Lede>{description}</Lede>
    </PageHero>

    <section class="section grid gap-8" aria-label="Work experience">
      <Screenly />
      <DostAstiBackend />
      <Nokia />
      <DostAstiTestAutomation />
    </section>
  </main>
</Layout>
