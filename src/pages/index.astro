---
import { getCollection } from 'astro:content';
import Layout from '@/components/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import TypedLede from '@/components/TypedLede.astro';
import SkillsMarquee from '@/components/SkillsMarquee.astro';
import { formatPostDate, postSlug } from '@/lib/posts';
import { JOB_TITLE, LINKEDIN_URL, SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '@/lib/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  jobTitle: JOB_TITLE,
  url: SITE_URL,
  sameAs: ['https://github.com/nicomiguelino', LINKEDIN_URL],
}).replace(/</g, '\\u003c');
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION} canonicalPath="/">
  <script type="application/ld+json" is:inline set:html={personSchema}></script>
  <main class="content-shell">
    <PageHero title="Home" hideTitle>
      <TypedLede text={SITE_DESCRIPTION} />
    </PageHero>

    <section class="section" aria-label="Recent posts">
      <div class="flex justify-center w-full">
        <div class="card max-w-[1080px]">
          <div class="about-prose">
            <p>
              Hi, I'm Nico, a full-stack engineer who likes building things for the web, frontend or backend. I've
              rebuilt this site in Jekyll, Angular, and now Astro, mostly because I can't resist a good excuse to
              tinker. When I'm not coding, I'm usually listening to or playing music in my room.
            </p>

            <p>If any of this sounds interesting, feel free to reach out.</p>
          </div>
        </div>
      </div>

      {posts.length === 0 ? (
        <p class="font-mono text-muted">No posts yet, check back soon.</p>
      ) : (
        <nav class="commit-tree" aria-label="Recent posts">
          <a class="commit-tree-head" href="/blog/" title="All posts">
            Blog
          </a>
          {posts.map((post) => (
            <a href={`/blog/${postSlug(post)}/`}>
              {post.data.title}
              <span class="text-[0.75rem] font-semibold text-muted">{formatPostDate(post.data.date)}</span>
            </a>
          ))}
        </nav>
      )}
    </section>

    <SkillsMarquee />
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  .commit-tree {
    @apply ml-[5px] grid gap-[1.15rem] border-l-2 border-line font-mono;
  }

  .commit-tree a {
    @apply relative flex flex-wrap items-baseline gap-x-4 gap-y-[0.3rem] pl-5;
    @apply text-[0.95rem] leading-[1.45] font-bold text-ink;
  }

  .commit-tree a::before {
    content: '';
    @apply absolute top-[0.28em] -left-[6px] size-[10px] rounded-full border-2 border-line-strong bg-bg;
    @apply transition-[border-color,background] duration-150 ease-[ease];
  }

  .commit-tree a:hover {
    @apply text-accent;
  }

  .commit-tree a:hover::before {
    @apply border-accent;
  }

  .commit-tree .commit-tree-head {
    @apply text-accent hover:underline;
  }

  .commit-tree .commit-tree-head::before {
    @apply top-[0.24em] -left-[7px] size-[12px] border-accent bg-accent;
  }

  .card {
    @apply rounded-lg border border-line bg-bg-elevated p-6 mb-20;
  }

  .about-prose p {
    @apply mb-[1.2rem] text-[1rem] leading-[1.75] last:mb-0;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }
</style>
