---
import Button from '@/components/common/Button.astro';
import Card from '@/components/common/Card.astro';
import FallingLeaves from '@/components/effects/FallingLeaves.astro';
import FallingPetals from '@/components/effects/FallingPetals.astro';
import FallingSnow from '@/components/effects/FallingSnow.astro';
import HeatShimmer from '@/components/effects/HeatShimmer.astro';
import Layout from '@/components/layout/Layout.astro';
import Highlight from '@/components/common/Highlight.astro';
import InstantPhoto from '@/components/common/InstantPhoto.astro';
import Icon from '@/components/common/Icon.astro';
import PageHero from '@/components/common/PageHero.astro';
import Sunlight from '@/components/effects/Sunlight.astro';
import portrait from '@/assets/home/portrait.png';
import { getIcon } from '@/lib/icons';
import { JOB_TITLE, LINKEDIN_URL, SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '@/lib/site';

const focusAreas = [
  {
    icon: getIcon('database'),
    title: 'Backend',
    description: 'Python services and APIs with Django and Flask, including migrating legacy stacks.',
  },
  {
    icon: getIcon('device-desktop'),
    title: 'Frontend',
    description: 'React and TypeScript interfaces for dashboards, tools, and content-rich sites.',
  },
  {
    icon: getIcon('terminal-2'),
    title: 'Automation',
    description: 'Test automation, integrations, and tooling that remove repetitive work.',
  },
  {
    icon: getIcon('book'),
    title: 'Documentation',
    description: 'READMEs, guides, and decision logs that explain how things work and why.',
  },
  {
    icon: getIcon('git-pull-request'),
    title: 'Open source',
    description: 'Maintaining and contributing to open-source projects through issues and pull requests.',
  },
  {
    icon: getIcon('tools'),
    title: 'Developer experience',
    description: 'Easy setup, smooth workflows, and clear tooling that make a codebase pleasant to work in.',
  },
];

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  jobTitle: JOB_TITLE,
  url: SITE_URL,
  sameAs: ['https://github.com/nicomiguelino', LINKEDIN_URL],
}).replace(/</g, '\\u003c');
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION} canonicalPath="/">
  <script type="application/ld+json" is:inline set:html={personSchema}></script>
  <FallingLeaves />
  <FallingSnow />
  <FallingPetals />
  <Sunlight />
  <HeatShimmer>
    <main class="content-shell">
      <PageHero title="Home" hideTitle>
        <div
          class:list={[
            'flex',
            'items-center',
            'justify-between',
            'gap-12',
            'max-md:flex-col',
            'max-md:items-start',
            'max-md:gap-8',
          ]}
        >
          <div class="flex flex-col items-start gap-8">
            <h2 class:list={['text-[clamp(3rem,4.5vw,4.25rem)]', 'leading-[1.1]', 'tracking-[-0.03em]']}>
              A place for my <Highlight handDrawn>thoughts</Highlight>, <Highlight handDrawn>machinations</Highlight>,
              and <Highlight handDrawn>anything tech-related</Highlight>
            </h2>
            <div class="flex flex-wrap gap-4">
              <Button href="/blog/">
                Read the blog
                <Icon icon={getIcon('arrow-right')} />
              </Button>
              <Button href="/projects/" variant="secondary">
                See projects
              </Button>
            </div>
          </div>
          <InstantPhoto
            src={portrait}
            alt="Illustration of Nico resting their chin on a hand, wearing glasses and a brown hoodie"
            caption="Hi, I'm Nico!"
            position="50% 25%"
            loading="eager"
            class:list={['w-full', 'max-w-72', 'sm:max-w-96', 'md:max-w-72', 'max-md:self-center', 'shrink-0']}
          />
        </div>
      </PageHero>

      <section class="section" aria-label="About">
        <div class="mt-10 w-full">
          <Card>
            <div class="about-prose">
              <!-- prettier-ignore -->
              <p>
                Hi, I'm Nico, a <Highlight bold handDrawn>full-stack engineer</Highlight> who likes building things for the web, frontend or backend. I turn annoying problems into convenient tools, using <Highlight bold handDrawn>engineering</Highlight> and <Highlight bold handDrawn>creativity</Highlight>.
              </p>

              <!-- prettier-ignore -->
              <p>
                If any of this sounds interesting, <Highlight bold handDrawn>feel free to reach out</Highlight>.
              </p>
            </div>
          </Card>

          <h2
            id="focus-heading"
            class:list={['mt-16', 'mb-8', 'text-[clamp(2rem,3.2vw,2.75rem)]', 'leading-[1.1]', 'tracking-[-0.03em]']}
          >
            What I <Highlight handDrawn>focus on</Highlight>
          </h2>

          <ul aria-labelledby="focus-heading" class="m-0 grid list-none grid-cols-1 gap-5 p-0 md:grid-cols-3">
            {focusAreas.map(({ icon, title, description }) => (
              <Card as="li" class="flex min-h-72 flex-col p-8">
                <span
                  class:list={[
                    'inline-flex',
                    'size-14',
                    'items-center',
                    'justify-center',
                    'border-2',
                    'border-ink',
                    'bg-accent',
                    'text-bg',
                    'shadow-[3px_3px_0_0_var(--ink)]',
                  ]}
                >
                  <Icon icon={icon} class="size-7" />
                </span>
                <h3
                  class:list={[
                    'm-0',
                    'mt-6',
                    'text-[1.5em]',
                    'leading-[1.2]',
                    'font-bold',
                    'tracking-[0.005em]',
                    'text-ink',
                  ]}
                >
                  {title}
                </h3>
                <p class="mt-3 text-[1.05rem] leading-[1.55] text-ink-soft">{description}</p>
              </Card>
            ))}
          </ul>
        </div>
      </section>
    </main>
  </HeatShimmer>
</Layout>

<style>
  @reference "@/styles/global.css";

  .about-prose p {
    @apply mb-[1.2rem] font-heading text-[1.3rem] leading-[1.75] last:mb-0;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }
</style>
