---
import Layout from '@/components/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import { JOB_TITLE, LINKEDIN_URL, SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '@/lib/site';

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  jobTitle: JOB_TITLE,
  url: SITE_URL,
  sameAs: ['https://github.com/nicomiguelino', LINKEDIN_URL],
}).replace(/</g, '\\u003c');
---

<Layout title={SITE_NAME} description={SITE_DESCRIPTION} canonicalPath="/">
  <script type="application/ld+json" is:inline set:html={personSchema}></script>
  <main class="content-shell">
    <PageHero title="Home" hideTitle>
      <h2 class:list={['text-[clamp(2.5rem,3.2vw,3.1rem)]', 'leading-[1.25]']}>{SITE_DESCRIPTION}</h2>
    </PageHero>

    <section class="section" aria-label="About">
      <div class="flex justify-center w-full mt-10">
        <div class="card">
          <div class="about-prose">
            <p>
              Hi, I'm Nico, a full-stack engineer who likes building things for the web, frontend or backend. I turn
              annoying problems into convenient tools, using engineering and creativity. Years in, I still can't resist
              tinkering. When I'm not coding, I'm usually listening to or playing music in my room.
            </p>

            <p>If any of this sounds interesting, feel free to reach out.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  @reference "@/styles/global.css";

  .card {
    @apply rounded-none border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)];
  }

  .about-prose p {
    @apply mb-[1.2rem] font-heading text-[1.3rem] leading-[1.75] last:mb-0;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }
</style>
