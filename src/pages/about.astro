---
import Layout from '@/components/Layout.astro';
import TypedLede from '@/components/TypedLede.astro';
import SkillsMarquee from '@/components/SkillsMarquee.astro';
import { SITE_NAME } from '@/lib/site';

const description = 'I build things for the web and write about what I learn';
---

<Layout
  title=`About — ${SITE_NAME}`
  description={description}
  canonicalPath="/about/"
>
  <main class="content-shell" data-pagefind-body>
    <div class="page-hero">
      <h1 class="visually-hidden">About</h1>
      <TypedLede text={description} />
    </div>

    <div class="section" style="max-width: var(--max);">
      <div class="about-grid">
        <div class="about-me">
          <div class="about-card">
            <h3>About</h3>
            <div class="about-prose">
              <p>
                Hi, I'm Nico, a full-stack engineer who likes building things for the web, frontend or backend.
                I've rebuilt this site in Jekyll, Angular, and now Astro, mostly because I can't resist a good excuse to tinker. When I'm not coding, I'm usually listening to or playing music in my room.
              </p>

              <p>
                If any of this sounds interesting, feel free to reach out.
              </p>
            </div>
          </div>
        </div>

        <aside>
          <div class="sidebar-card">
            <h3>Education</h3>
            <div class="edu-entry">
              <p class="edu-degree">B.S. Computer Science</p>
              <p class="edu-school"><a href="https://www.ust.edu.ph/" target="_blank" rel="noopener" style="color: var(--accent);">University of Santo Tomas</a> · 2016</p>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <SkillsMarquee />
  </main>
</Layout>
