---
import Layout from '@/components/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import TypedLede from '@/components/TypedLede.astro';
import SkillsMarquee from '@/components/SkillsMarquee.astro';
import { SITE_NAME } from '@/lib/site';

const description = 'I build things for the web and write about what I learn';
---

<Layout title=`About — ${SITE_NAME}` description={description} canonicalPath="/about/">
  <main class="content-shell" data-pagefind-body>
    <PageHero title="About" hideTitle>
      <TypedLede text={description} />
    </PageHero>

    <div class="section">
      <div class="grid grid-cols-[minmax(0,1fr)_minmax(280px,0.4fr)] items-start gap-16 max-[860px]:block">
        <div class="about-me">
          <div class="card">
            <h3>About</h3>
            <div class="about-prose">
              <p>
                Hi, I'm Nico, a full-stack engineer who likes building things for the web, frontend or backend. I've
                rebuilt this site in Jekyll, Angular, and now Astro, mostly because I can't resist a good excuse to
                tinker. When I'm not coding, I'm usually listening to or playing music in my room.
              </p>

              <p>If any of this sounds interesting, feel free to reach out.</p>
            </div>
          </div>
        </div>

        <aside>
          <div class="card sticky top-24 max-[860px]:static max-[860px]:mt-12">
            <h3>Education</h3>
            <div class="mb-4 last:mb-0">
              <p class="text-[0.88rem] font-bold text-ink">B.S. Computer Science</p>
              <p class="mt-[0.15rem] font-mono text-[0.75rem] text-muted">
                <a href="https://www.ust.edu.ph/" target="_blank" rel="noopener" class="text-accent">
                  University of Santo Tomas
                </a>{' '}
                · 2016
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <SkillsMarquee />
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  .card {
    @apply rounded-lg border border-line bg-bg-elevated p-6;
  }

  .card h3 {
    @apply mb-4 font-mono text-[1rem] font-bold tracking-[0.14em] text-muted;
  }

  .about-prose p {
    @apply mb-[1.2rem] max-w-[62ch] text-[1rem] leading-[1.75] last:mb-0;
    color: color-mix(in srgb, var(--ink) 82%, var(--muted));
  }
</style>
