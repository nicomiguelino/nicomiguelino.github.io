---
import { getCollection } from 'astro:content';
import Layout from '@/components/Layout.astro';
import TypedLede from '@/components/TypedLede.astro';
import SkillsMarquee from '@/components/SkillsMarquee.astro';
import PostCard from '@/components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '@/lib/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const lede = "Notes on what I'm building, learning, and figuring out along the way";
---

<Layout
  title=`Blog — ${SITE_NAME}`
  description={SITE_DESCRIPTION}
  canonicalPath="/blog/"
>
  <main class="content-shell">
    <section class="page-hero">
      <h1 class="visually-hidden">Blog</h1>
      <TypedLede text={lede}/>
    </section>

    <section class="section" aria-label="Blog posts">
      {posts.length === 0 ? (
        <p style="color: var(--muted); font-family: var(--mono);">No posts yet, check back soon.</p>
      ) : (
        <div class="post-list">
          {posts.map((post, index) => <PostCard post={post} latest={index === 0} />)}
        </div>
      )}
    </section>

    <SkillsMarquee />
  </main>
</Layout>
