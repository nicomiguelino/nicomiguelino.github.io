---
import { getCollection } from 'astro:content';
import Layout from '@/components/Layout.astro';
import Lede from '@/components/Lede.astro';
import PageHero from '@/components/PageHero.astro';
import PostCard from '@/components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '@/lib/site';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const lede = "Notes on what I'm building, learning, and figuring out along the way";
---

<Layout title=`Blog — ${SITE_NAME}` description={SITE_DESCRIPTION} canonicalPath="/blog/">
  <main class="content-shell">
    <PageHero title="Blog" hideTitle>
      <Lede>{lede}</Lede>
    </PageHero>

    <section class="section" aria-label="Blog posts">
      {posts.length === 0 ? (
        <p class="text-muted">No posts yet, check back soon.</p>
      ) : (
        <div class="grid">
          {posts.map((post, index) => (
            <PostCard post={post} latest={index === 0} />
          ))}
        </div>
      )}
    </section>
  </main>
</Layout>
