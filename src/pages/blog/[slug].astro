---
import { getCollection, render } from 'astro:content';
import Layout from '@/components/Layout.astro';
import { formatPostDate, postSlug } from '@/lib/posts';
import { slugifyTag } from '@/lib/tags';
import { SITE_NAME, SITE_URL } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => {
      const slug = postSlug(post);
      return {
        params: { slug },
        props: { post, slug },
      };
    });
}

const { post, slug } = Astro.props;
const { Content, headings } = await render(post);
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const tags = post.data.tags.filter((tag) => slugifyTag(tag) !== '');

const postSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  url: new URL(`/blog/${slug}/`, Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: SITE_NAME,
    url: new URL('/', SITE_URL).toString(),
  },
}).replace(/</g, '\\u003c');
---

<Layout
  title={`${post.data.title} — ${SITE_NAME}`}
  description={post.data.description}
  canonicalPath={`/blog/${slug}/`}
  ogType="article"
>
  <script type="application/ld+json" is:inline set:html={postSchema}></script>
  <main class="content-shell">
    <div class="article-layout section">
      <aside class="article-toc" aria-label="Article sections">
        {sectionHeadings.length > 0 && (
          <nav class="ml-[5px] grid gap-[0.9rem] border-l-2 border-line">
            {sectionHeadings.map((heading) => (
              <a href={`#${heading.slug}`} data-heading-link={heading.slug}>
                {heading.text}
              </a>
            ))}
          </nav>
        )}
      </aside>

      <article class="min-w-0" data-pagefind-body>
        <header class="mb-[2.35rem] border-b border-line pb-8">
          <p class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
            {tags.map((tag) => (
              <a href={`/tags/${slugifyTag(tag)}/`} data-pagefind-ignore>
                #{tag}
              </a>
            ))}
          </p>
          <h1 class="m-0 max-w-[22ch] font-mono text-[clamp(2rem,4vw,3.4rem)] leading-none font-normal tracking-[-0.055em] text-ink">
            {post.data.title}
          </h1>
          <p class="mt-[1.2rem] max-w-[680px] text-[1.18rem] leading-[1.7] text-[color-mix(in_srgb,var(--ink)_68%,var(--muted))]">
            {post.data.description}
          </p>
        </header>
        <div class="article-prose">
          <Content />
        </div>
        <section class="mt-[3.2rem] border-t border-line pt-[2.2rem]" aria-label="Comments">
          <div id="remark42"></div>
        </section>
      </article>
    </div>
  </main>

  <script>
    const REMARK_HOST = 'https://comments.nicomiguelino.github.io';

    type Remark42 = {
      createInstance: (config: Record<string, unknown>) => { destroy: () => void };
      changeTheme: (theme: 'light' | 'dark') => void;
    };
    const w = window as typeof window & {
      remark_config?: Record<string, unknown>;
      REMARK42?: Remark42;
    };

    let tocObserver: IntersectionObserver | undefined;
    let commentsInstance: { destroy: () => void } | undefined;
    let embedRequested = false;

    function initToc() {
      tocObserver?.disconnect();
      const headings = Array.from(document.querySelectorAll('.article-prose h2[id]'));
      const links = new Map(
        Array.from(document.querySelectorAll('[data-heading-link]')).map((link) => [
          link.getAttribute('data-heading-link'),
          link,
        ]),
      );
      if (headings.length === 0 || links.size === 0) return;

      function setActive(id: string) {
        for (const link of links.values()) link.removeAttribute('aria-current');
        links.get(id)?.setAttribute('aria-current', 'true');
      }

      setActive(headings[0].id);
      tocObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible?.target instanceof HTMLElement) setActive(visible.target.id);
        },
        { rootMargin: '-18% 0px -68% 0px', threshold: 0 },
      );
      for (const heading of headings) tocObserver.observe(heading);
    }

    function paletteTheme(): 'light' | 'dark' {
      const bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
      const hex = bg.replace('#', '');
      const full = hex.length === 3 ? [...hex].map((c) => c + c).join('') : hex;
      const luma =
        0.2126 * parseInt(full.slice(0, 2), 16) +
        0.7152 * parseInt(full.slice(2, 4), 16) +
        0.0722 * parseInt(full.slice(4, 6), 16);
      return luma > 128 ? 'light' : 'dark';
    }

    function initComments() {
      const node = document.getElementById('remark42');
      if (!node) {
        try {
          commentsInstance?.destroy();
        } catch {}
        commentsInstance = undefined;
        return;
      }
      if (window.location.hostname !== 'nicomiguelino.github.io') return;

      w.remark_config = {
        host: REMARK_HOST,
        site_id: 'example',
        url: window.location.origin + window.location.pathname,
        theme: paletteTheme(),
        show_email_subscription: false,
      };

      if (w.REMARK42) {
        try {
          commentsInstance?.destroy();
        } catch {}
        commentsInstance = w.REMARK42.createInstance(w.remark_config);
      } else if (!embedRequested) {
        embedRequested = true;
        const script = document.createElement('script');
        script.src = `${REMARK_HOST}/web/embed.mjs`;
        script.type = 'module';
        document.head.append(script);
      }
    }

    new MutationObserver(() => {
      w.REMARK42?.changeTheme(paletteTheme());
    }).observe(document.documentElement, { attributeFilter: ['data-palette'] });

    function init() {
      initToc();
      initComments();
    }

    init();
    document.addEventListener('astro:page-load', init);
  </script>
</Layout>

<style>
  @reference "@/styles/global.css";

  .post-meta {
    @apply mb-[0.85rem] flex flex-wrap items-center gap-[0.55rem];
    @apply font-mono text-[0.78rem] font-bold tracking-[-0.03em] uppercase;
    color: color-mix(in srgb, var(--ink) 58%, var(--muted));
  }

  .post-meta > * + *::before {
    content: '/';
    @apply mr-[0.55rem] text-line-strong;
  }

  .article-layout {
    @apply relative grid grid-cols-[minmax(8rem,12rem)_minmax(0,860px)] items-start gap-[clamp(2rem,6vw,4rem)] pt-16;
    @apply border-t-0;
    @apply max-[1040px]:block max-[1040px]:max-w-[860px] max-sm:pt-[2.25rem];
  }

  .article-toc {
    @apply sticky top-24 pt-[0.35rem] font-mono text-[0.78rem] max-[1040px]:hidden;
    color: color-mix(in srgb, var(--ink) 58%, var(--muted));
  }

  .article-toc a {
    @apply relative pl-[1.1rem] leading-[1.35];
    color: color-mix(in srgb, var(--ink) 58%, var(--muted));
  }

  .article-toc a::before {
    content: '';
    @apply absolute top-[0.22em] -left-[6px] size-[10px] rounded-full border-2 border-line-strong bg-bg;
    @apply transition-[border-color,background] duration-150 ease-[ease];
  }

  .article-toc a:hover,
  .article-toc a[aria-current='true'] {
    @apply text-accent;
  }

  .article-toc a:hover::before {
    @apply border-accent;
  }

  .article-toc a[aria-current='true']::before {
    @apply border-accent bg-accent;
  }
</style>
