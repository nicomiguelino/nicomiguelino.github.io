---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'figure'> {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
  loading?: 'eager' | 'lazy';
  position?: string;
}

const {
  src,
  alt,
  caption,
  width = 768,
  loading = 'lazy',
  position = '50% 40%',
  class: className,
  ...rest
} = Astro.props;
const frameClasses = [
  'relative',
  'm-0',
  'aspect-[8847/10752]',
  'rotate-2',
  'border-2',
  'border-ink',
  'bg-bg-elevated',
  'shadow-[6px_6px_0_0_var(--ink)]',
];
---

<figure class:list={[frameClasses, className]} {...rest}>
  <span
    class:list={[
      'absolute',
      '-top-3',
      'left-1/2',
      'h-6',
      'w-20',
      '-translate-x-1/2',
      'border-2',
      'border-ink',
      'bg-accent',
    ]}
    aria-hidden="true"
  ></span>
  <Image
    {src}
    {alt}
    {width}
    {loading}
    class:list={[
      'absolute',
      'top-[5.6%]',
      'left-[5.4%]',
      'aspect-[7894/7680]',
      'w-[89.2%]',
      'border-2',
      'border-ink',
      'object-cover',
    ]}
    style={`object-position: ${position}`}
  />
  {caption && (
    <figcaption
      class:list={[
        'absolute',
        'inset-x-0',
        'bottom-0',
        'flex',
        'h-[23.7%]',
        'items-center',
        'justify-center',
        'text-center',
        'font-handwriting',
        'text-[2rem]',
        'leading-none',
        'text-ink',
      ]}
    >
      {caption}
    </figcaption>
  )}
</figure>
