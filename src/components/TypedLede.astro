---
import Lede from '@/components/Lede.astro';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<Lede class="typed-lede">
  <span class="sr-only">{text}</span>
  <span class="typed-lede-target" aria-hidden="true">
    {text}
  </span>
</Lede>
<script is:inline data-astro-rerun>
  document.querySelectorAll('.typed-lede').forEach((wrap) => {
    if (wrap.dataset.typed) return;
    wrap.dataset.typed = '1';
    const target = wrap.querySelector('.typed-lede-target');
    if (!target) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const full = target.textContent || '';
    wrap.style.minHeight = wrap.getBoundingClientRect().height + 'px';
    target.textContent = '';
    let i = 0;
    const tick = () => {
      if (!target.isConnected) return;
      i += 1;
      target.textContent = full.slice(0, i);
      if (i < full.length) {
        setTimeout(tick, 26 + Math.random() * 38);
      } else {
        wrap.style.minHeight = '';
      }
    };
    setTimeout(tick, 200);
  });
</script>
