---
interface Props {
  href: string;
  size?: 'sm' | 'lg';
}

const { href, size = 'sm' } = Astro.props;
---

<a
  class:list={['tag', size === 'lg' ? 'px-3 py-[0.22rem] text-[0.78rem]' : 'px-[0.6rem] py-[0.14rem] text-[0.7rem]']}
  href={href}
>
  <slot />
</a>

<style>
  @reference "@/styles/global.css";

  .tag {
    @apply inline-flex items-center gap-[0.35rem] rounded-none border-2 border-ink bg-bg text-ink;
    @apply font-mono leading-[1.4] font-bold shadow-[2px_2px_0_0_var(--ink)];
    @apply transition-[translate,box-shadow,background-color,color] duration-120 ease-[ease];
  }

  .tag:hover {
    @apply translate-x-[2px] translate-y-[2px] bg-accent text-bg shadow-none;
  }
</style>
