---
import { faGithub } from '@fortawesome/free-brands-svg-icons';
import { faArrowUpRightFromSquare, faPalette } from '@fortawesome/free-solid-svg-icons';
import Icon from '@/components/Icon.astro';
import { ANIMATED_UNDERLINE_CLASSES } from '@/lib/animatedUnderline';

interface Props {
  name: string;
  description: string;
  technologies: string[];
  url: string;
  demoUrl?: string;
  themeUrl?: string;
  isCooking?: boolean;
}

const { name, description, technologies, url, demoUrl, themeUrl, isCooking = false } = Astro.props;
const linkLabel: string = isCooking ? 'Follow' : 'GitHub';
const linkAriaLabel: string = isCooking ? `Follow for updates on ${name}` : `View ${name} on GitHub`;
---

<article class="flex flex-col border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <h2 class="m-0 text-[1.5em] leading-[1.2] font-bold tracking-[0.005em] text-ink">{name}</h2>
    {isCooking && (
      <span class="border-2 border-ink bg-accent px-[0.6rem] py-[0.14rem] font-mono text-[0.7rem] leading-[1.4] font-bold text-bg">
        Cooking
      </span>
    )}
  </div>
  <p class="mt-3 leading-[1.55] text-ink-soft">{description}</p>
  {technologies.length > 0 && (
    <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0" aria-label={`${name} technologies`}>
      {technologies.map((technology) => (
        <li class="border-2 border-ink bg-bg px-[0.6rem] py-[0.14rem] font-mono text-[0.7rem] leading-[1.4] font-bold text-ink">
          {technology}
        </li>
      ))}
    </ul>
  )}
  <div
    class:list={[
      'mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5 font-heading font-bold text-accent',
      ...ANIMATED_UNDERLINE_CLASSES,
    ]}
  >
    <a class="inline-flex items-center gap-2" href={url} target="_blank" rel="noopener" aria-label={linkAriaLabel}>
      <Icon icon={faGithub} />
      {linkLabel}
    </a>
    {demoUrl && (
      <a
        class="inline-flex items-center gap-2"
        href={demoUrl}
        target="_blank"
        rel="noopener"
        aria-label={`View ${name} demo`}
      >
        <Icon icon={faArrowUpRightFromSquare} />
        Demo
      </a>
    )}
    {themeUrl && (
      <a
        class="inline-flex items-center gap-2"
        href={themeUrl}
        target="_blank"
        rel="noopener"
        aria-label={`View ${name} in the Astro themes library`}
      >
        <Icon icon={faPalette} />
        Theme
      </a>
    )}
  </div>
</article>
