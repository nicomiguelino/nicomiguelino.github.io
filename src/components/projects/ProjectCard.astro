---
import Card from '@/components/common/Card.astro';
import Icon from '@/components/common/Icon.astro';
import { ANIMATED_UNDERLINE_CLASSES } from '@/lib/animatedUnderline';
import { PROJECT_LINK_DEFINITIONS, type ProjectLink } from '@/lib/projects';

interface Props {
  name: string;
  description: string;
  technologies: string[];
  links: ProjectLink[];
  releaseRepository?: string;
}

const { name, description, technologies, links, releaseRepository } = Astro.props;
---

<Card as="article" class="flex flex-col">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <h2 class="m-0 text-[1.5em] leading-[1.2] font-bold tracking-[0.005em] max-w-full truncate text-ink" title={name}>
      {name}
    </h2>
    {releaseRepository && (
      <span
        hidden
        data-release-repository={releaseRepository}
        class:list={[
          'border-2',
          'border-ink',
          'bg-accent',
          'px-[0.6rem]',
          'py-[0.14rem]',
          'font-mono',
          'text-[0.7rem]',
          'leading-[1.4]',
          'font-bold',
          'text-bg',
        ]}
      >
        Latest
      </span>
    )}
  </div>
  <p class="mt-3 leading-[1.55] text-ink-soft">{description}</p>
  {technologies.length > 0 && (
    <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0" aria-label={`${name} technologies`}>
      {technologies.map((technology) => (
        <li
          class:list={[
            'border-2',
            'border-ink',
            'bg-bg',
            'px-[0.6rem]',
            'py-[0.14rem]',
            'font-mono',
            'text-[0.7rem]',
            'leading-[1.4]',
            'font-bold',
            'text-ink',
          ]}
        >
          {technology}
        </li>
      ))}
    </ul>
  )}
  <div
    class:list={[
      'mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5 font-heading font-medium text-accent',
      ...ANIMATED_UNDERLINE_CLASSES,
    ]}
  >
    {links.map((link) => {
      const definition = PROJECT_LINK_DEFINITIONS[link.kind];
      return (
        <a
          class="inline-flex items-center gap-2"
          href={link.url}
          target="_blank"
          rel="noopener"
          aria-label={definition.getAriaLabel(name)}
        >
          <Icon icon={definition.icon} />
          {definition.label}
        </a>
      );
    })}
  </div>
</Card>

<script>
  interface LatestRelease {
    tag_name: string;
  }

  async function getLatestVersion(repository: string): Promise<string> {
    const response = await fetch(`https://api.github.com/repos/${repository}/releases/latest`);
    if (!response.ok) {
      throw new Error(`Failed to load the latest release of ${repository}`);
    }
    const release: LatestRelease = await response.json();
    return release.tag_name;
  }

  async function showLatestVersion(badge: HTMLElement): Promise<void> {
    const repository = badge.dataset.releaseRepository ?? '';
    try {
      badge.textContent = await getLatestVersion(repository);
      badge.hidden = false;
    } catch {
      badge.hidden = true;
    }
  }

  const badges: HTMLElement[] = Array.from(document.querySelectorAll<HTMLElement>('[data-release-repository]'));
  badges.forEach((badge) => {
    void showLatestVersion(badge);
  });
</script>
