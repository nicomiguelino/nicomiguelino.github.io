---
import { SOURCE_URL } from '@/lib/site';
import type { ProjectLink } from '@/lib/projects';
import ProjectCard from './ProjectCard.astro';

interface Project {
  name: string;
  description: string;
  technologies: string[];
  links: ProjectLink[];
  isCooking?: boolean;
}

const projects: Project[] = [
  {
    name: 'nicomiguelino.github.io',
    description:
      'My personal portfolio and blog, and the site you are on right now. It has a Neobrutalist look and a palette that follows the seasons.',
    technologies: ['TypeScript', 'Astro', 'Tailwind CSS'],
    links: [{ kind: 'github', url: SOURCE_URL }],
  },
  {
    name: 'Seasons',
    description:
      'A season-aware Neobrutalist theme for Astro blogs. The idea came to me during a makeover of this site, and I thought: why not make it into a theme? The palette follows the calendar, with light and dark modes for every season.',
    technologies: ['TypeScript', 'Astro', 'Tailwind CSS'],
    links: [
      { kind: 'github', url: 'https://github.com/nicomiguelino/astro-seasons' },
      { kind: 'demo', url: 'https://nicomiguelino.github.io/astro-seasons/' },
      { kind: 'theme', url: 'https://astro.build/themes/details/seasons/' },
    ],
  },
  {
    name: 'Neobrutalist Web Components',
    description:
      'A library of Neobrutalist custom elements built with Lit and Vite. You can use them from TypeScript or from vanilla HTML, CSS, and JavaScript.',
    technologies: ['TypeScript', 'Lit', 'Vite', 'Web Components'],
    links: [{ kind: 'github', url: 'https://github.com/nicomiguelino/neobrutalist-web-components' }],
    isCooking: true,
  },
];
---

<section class="section grid grid-cols-1 gap-8 md:grid-cols-2" aria-label="Projects">
  {projects.map((project) => (
    <ProjectCard {...project} />
  ))}
</section>
