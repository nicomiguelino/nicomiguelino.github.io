---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate, postSlug } from '@/lib/posts';
import { slugifyTag } from '@/lib/tags';
import Tag from '@/components/Tag.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  latest?: boolean;
}

const { post, latest = false } = Astro.props;
const tags = post.data.tags.filter((tag) => slugifyTag(tag) !== '');
---

<article class="group border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)] transition-[translate,box-shadow] duration-120 ease-[ease] hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-[3px_3px_0_0_var(--ink)]">
  <a class="block" href={`/blog/${postSlug(post)}/`}>
    <div>
      <h2 class="m-0 text-[clamp(1.45rem,3vw,2.05rem)] leading-none font-bold tracking-[0.005em] text-ink transition-colors duration-160 ease-[ease] group-hover:text-accent">
        {post.data.title}
      </h2>
      {latest && (
        <div class="mt-3">
          <span class="inline-block border-2 border-ink bg-accent px-3 py-1 font-heading text-[0.95rem] leading-none font-bold tracking-[0.04em] text-bg shadow-[3px_3px_0_0_var(--ink)]">
            latest
          </span>
        </div>
      )}
      <p class="mt-[0.55rem] max-w-[680px] leading-[1.55] text-[color-mix(in_srgb,var(--ink)_62%,var(--muted))]">
        {post.data.description}
      </p>
      <p class="mt-[0.4rem] max-w-[680px] text-[0.75rem] leading-[1.55] font-semibold text-muted">
        {formatPostDate(post.data.date)}
      </p>
    </div>
  </a>
  {tags.length > 0 && (
    <p class="mt-4 flex max-w-[680px] flex-wrap gap-2">
      {tags.map((tag) => (
        <Tag href={`/tags/${slugifyTag(tag)}/`}>#{tag}</Tag>
      ))}
    </p>
  )}
</article>
