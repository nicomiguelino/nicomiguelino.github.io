---
import ExperienceEntry from './ExperienceEntry.astro';

const pythonThreeMigrationPullRequestUrl: string = 'https://github.com/Screenly/Anthias/pull/1743';
const flaskToDjangoMigrationPullRequestUrl: string = 'https://github.com/Screenly/Anthias/pull/2040';
const reactMigrationPullRequestUrl: string = 'https://github.com/Screenly/Anthias/pull/2265';
const salesforceAppUrl: string = 'https://www.screenly.io/apps/salesforce-dashboard/';
const airtableAppUrl: string = 'https://www.screenly.io/apps/airtable-dashboard/';
const grafanaAppUrl: string = 'https://www.screenly.io/apps/grafana-dashboard/';
const slackAppUrl: string = 'https://www.screenly.io/apps/slack-messages/';
const browserExtensionRepositoryUrl: string = 'https://github.com/Screenly/Browser-Extension';
const zapierIntegrationRepositoryUrl: string = 'https://github.com/Screenly/zapier';
---

<ExperienceEntry
  role="Software Engineer"
  organization={{ name: 'Screenly', url: 'https://www.screenly.io/' }}
  dates="October 2022 - September 2026"
>
  <!-- prettier-ignore -->
  <p>
    I maintained{' '}
    <a href="https://github.com/Screenly/Anthias" target="_blank" rel="noopener">
      Anthias</a>, Screenly's free and open-source digital signage solution, regularly checking it for issues and
    possible change requests. Among the tasks that interested me most were the stack
    migrations:{' '}
    <a href={pythonThreeMigrationPullRequestUrl} target="_blank" rel="noopener">
      Python 2 to 3</a>,{' '}
    <a href={flaskToDjangoMigrationPullRequestUrl} target="_blank" rel="noopener">
      Flask to Django</a>, and{' '}
    <a href={reactMigrationPullRequestUrl} target="_blank" rel="noopener">
      CoffeeScript and Backbone.js to TypeScript and React</a>.
  </p>
  <!-- prettier-ignore -->
  <p>
    Beyond Anthias, I maintained and migrated more than 30 small digital signage apps that connect to third-party
    services like{' '}
    <a href={salesforceAppUrl} target="_blank" rel="noopener">
      Salesforce</a>,{' '}
    <a href={airtableAppUrl} target="_blank" rel="noopener">
      Airtable</a>,{' '}
    <a href={grafanaAppUrl} target="_blank" rel="noopener">
      Grafana</a>, and{' '}
    <a href={slackAppUrl} target="_blank" rel="noopener">
      Slack</a>, pulling and displaying their data through REST APIs. One of my favorite parts of this work was
    co-initiating{' '}
    <a href="https://www.npmjs.com/package/@screenly/edge-apps" target="_blank" rel="noopener">
      @screenly/edge-apps</a>, an NPM package that provides frontend utilities for developing Screenly digital signage
    apps. Other contributions include reviving and overhauling the{' '}
    <a href={browserExtensionRepositoryUrl} target="_blank" rel="noopener">
      browser extension</a> and building the{' '}
    <a href={zapierIntegrationRepositoryUrl} target="_blank" rel="noopener">
      Zapier integration</a> for Screenly.
  </p>
</ExperienceEntry>
