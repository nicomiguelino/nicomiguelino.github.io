---
interface Props {
  role: string;
  dates: string;
  organization: {
    name: string;
    url?: string;
  };
}

const { role, dates, organization } = Astro.props;
---

<article class="border-2 border-ink bg-bg-elevated p-6 shadow-[6px_6px_0_0_var(--ink)]">
  <h2 class="m-0 text-[1.5em] leading-[1.2] font-bold tracking-[0.005em] [&_a]:text-accent">
    {role},{' '}
    {organization.url ? (
      <a href={organization.url} target="_blank" rel="noopener">
        {organization.name}
      </a>
    ) : (
      organization.name
    )}
  </h2>
  <p class="mt-3 inline-block border-2 border-ink bg-accent px-3 py-1 font-heading text-[0.8rem] leading-none font-bold text-bg shadow-[2px_2px_0_0_var(--ink)]">
    {dates}
  </p>

  <div class="mt-4 space-y-4 text-ink-soft [&_a]:text-accent">
    <slot />
  </div>
</article>
