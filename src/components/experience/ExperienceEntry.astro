---
interface Props {
  title: string;
  dates: string;
}

const { title, dates } = Astro.props;
---

<article class="station">
  <span class="stop" aria-hidden="true"></span>
  <h2>{title}</h2>
  <p class="experience-dates">{dates}</p>

  <ul>
    <slot />
  </ul>
</article>

<style>
  .station {
    --rail-x: 0.75rem;
    --stop-y: 0.9rem;
    position: relative;
    padding: 0 0 2.5rem 3rem;
  }

  .station::before {
    content: '';
    position: absolute;
    left: var(--rail-x);
    top: 0;
    bottom: 0;
    width: 5px;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .station:first-of-type::before {
    top: var(--stop-y);
  }

  .station:last-of-type::before {
    bottom: auto;
    height: var(--stop-y);
  }

  .station:only-of-type::before {
    display: none;
  }

  .stop {
    position: absolute;
    left: var(--rail-x);
    top: var(--stop-y);
    width: 1.25rem;
    height: 1.25rem;
    border: 5px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
    transform: translate(-50%, -50%);
    box-sizing: border-box;
  }

  .station:first-of-type .stop,
  .station:last-of-type .stop {
    width: 1.6rem;
    height: 1.6rem;
  }

  h2,
  .experience-dates {
    font-family: var(--mono);
  }

  h2 {
    margin: 0;
    line-height: calc(var(--stop-y) * 2);
    font-weight: 400;
  }

  .experience-dates {
    display: inline-block;
    margin: 0.7rem 0 0;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-md);
    background: var(--ink);
    color: var(--bg);
    font-size: 0.8rem;
  }

  ul {
    color: var(--ink-soft);
  }

  ul :global(a) {
    color: var(--accent);
  }
</style>
