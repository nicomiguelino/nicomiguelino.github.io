---
interface Props {
  role: string;
  dates: string;
  organization: {
    name: string;
    url?: string;
  };
}

const { role, dates, organization } = Astro.props;
---

<article class="station group">
  <span
    class="absolute top-(--stop-y) left-(--rail-x) size-5 -translate-1/2 rounded-full border-5 border-accent bg-bg group-first-of-type:bg-accent"
    aria-hidden="true"
  ></span>
  <h2 class="m-0 font-mono text-[1.5em] leading-[calc(var(--stop-y)*2)] font-normal [&_a]:text-accent">
    {role},{' '}
    {organization.url ? (
      <a href={organization.url} target="_blank" rel="noopener">
        {organization.name}
      </a>
    ) : (
      organization.name
    )}
  </h2>
  <p class="mt-[0.7rem] inline-block rounded-md bg-ink px-[0.6rem] py-[0.15rem] font-mono text-[0.8rem] text-bg">
    {dates}
  </p>

  <ul class="my-4 list-disc pl-10 text-ink-soft [&_a]:text-accent">
    <slot />
  </ul>
</article>

<style>
  @reference "../../styles/global.css";

  .station {
    --rail-x: 0.75rem;
    --stop-y: 0.9rem;
    @apply relative pb-10 pl-12;
  }

  .station::before {
    content: '';
    @apply absolute inset-y-0 left-(--rail-x) w-[5px] -translate-x-1/2 bg-accent;
  }

  .station:first-of-type::before {
    top: var(--stop-y);
  }

  .station:last-of-type::before {
    bottom: auto;
    height: var(--stop-y);
  }

  .station:only-of-type::before {
    display: none;
  }
</style>
