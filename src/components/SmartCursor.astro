<div class="smart-cursor" transition:persist aria-hidden="true">
  <svg class="cursor-leaf" viewBox="0 0 24 24">
    <path d="M12 2L14.4 6.2L17.52 5L16.56 10.2L20.64 9L19.2 12.3L24 13.6L16.56 17.6L17.52 20.2L12.96 19.4V22.5H11.04V19.4L6.48 20.2L7.44 17.6L0 13.6L4.8 12.3L3.36 9L7.44 10.2L6.48 5L9.6 6.2Z"></path>
  </svg>
</div>

<script>
  const cursor: HTMLDivElement | null = document.querySelector('.smart-cursor');
  const hasFinePointer: boolean = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (cursor && hasFinePointer) {
    window.addEventListener('mousemove', (event: MouseEvent): void => {
      cursor.style.transform = `translate(${event.clientX}px, ${event.clientY}px) translate(-50%, -50%)`;
      cursor.dataset.visible = 'true';
    });

    document.documentElement.addEventListener('mouseleave', (): void => {
      cursor.dataset.visible = 'false';
    });
  }
</script>

<style>
  .smart-cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    pointer-events: none;
    opacity: 0;
  }

  .smart-cursor[data-visible='true'] {
    opacity: 1;
  }

  .cursor-leaf {
    display: none;
    width: 100%;
    height: 100%;
    fill: var(--accent);
    transform: translateY(41.7%) rotate(-30deg);
    transform-origin: 50% 8.3%;
  }

  :global([data-palette^='autumn']) .smart-cursor {
    width: 36px;
    height: 36px;
    border-radius: 0;
    background: transparent;
  }

  :global([data-palette^='autumn']) .cursor-leaf {
    display: block;
  }
</style>
