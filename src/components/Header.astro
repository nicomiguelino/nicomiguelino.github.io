---
import { LINKEDIN_URL, SITE_NAME } from '@/lib/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-20 border-b border-line bg-bg/92 backdrop-blur-md">
  <nav class="nav" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label={SITE_NAME}>
      <span>{SITE_NAME}</span>
    </a>

    <details class="ml-auto hidden max-[860px]:flex">
      <summary class="nav-menu-button" aria-label="Open navigation">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <div class="nav-menu-panel">
        <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
          Home
        </a>
        <a href="/blog/" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>
          Blog
        </a>
        <a href="/experience/" aria-current={currentPath === '/experience/' ? 'page' : undefined}>
          Experience
        </a>
        <a href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>
          About
        </a>
      </div>
    </details>

    <div class="nav-links">
      <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>
        Home
      </a>
      <a href="/blog/" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}>
        Blog
      </a>
      <a href="/experience/" aria-current={currentPath === '/experience/' ? 'page' : undefined}>
        Experience
      </a>
      <a href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>
        About
      </a>
    </div>

    <div class="flex items-center gap-[0.45rem] max-sm:basis-full max-sm:justify-end max-sm:gap-[0.35rem]">
      <button class="nav-icon-link cursor-pointer" type="button" id="search-open" aria-label="Search (Ctrl+K)">
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3" />
        </svg>
      </button>
      <a
        class="nav-icon-link"
        href="https://github.com/nicomiguelino"
        aria-label="GitHub"
        target="_blank"
        rel="noopener"
      >
        <svg class="size-4 fill-current" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.64 7.64 0 0 1 8 3.87c.68 0 1.36.09 2 .26 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
      <a class="nav-icon-link" href={LINKEDIN_URL} aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
      </a>
      <a class="nav-icon-link" href="/rss.xml" aria-label="RSS feed">
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  @reference "../styles/global.css";

  .nav {
    @apply relative mx-auto flex max-w-(--max) items-center justify-between gap-4 px-5 py-[0.85rem];
    @apply max-sm:flex-wrap max-sm:gap-y-2;
  }

  .brand {
    @apply inline-flex items-center gap-[0.55rem] font-mono font-bold tracking-[-0.04em] text-ink;
  }

  .nav-links {
    @apply flex items-center gap-5 font-mono text-[0.9rem] text-muted max-[860px]:hidden;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    @apply text-accent;
  }

  .nav-menu-button {
    @apply inline-flex size-[2.1rem] cursor-pointer list-none flex-col items-center justify-center gap-[0.22rem];
    @apply rounded-md border border-line text-ink-soft transition-colors duration-120 ease-[ease];
  }

  .nav-menu-button::-webkit-details-marker {
    display: none;
  }
  .nav-menu-button::marker {
    content: '';
  }

  .nav-menu-button span {
    @apply block h-px w-[0.92rem] bg-current;
  }

  .nav-menu-panel {
    @apply absolute top-[calc(100%_+_0.5rem)] right-5 z-30 grid min-w-[min(18rem,calc(100vw-2rem))] p-[0.35rem];
    @apply rounded-md border border-line-strong bg-bg-elevated shadow-[0_16px_44px_rgba(0,0,0,0.16)];
  }

  .nav-menu-panel a {
    @apply rounded-sm px-[0.7rem] py-[0.62rem] font-mono text-[0.86rem] font-semibold text-ink-soft;
  }

  .nav-menu-panel a:hover,
  .nav-menu-panel a[aria-current='page'] {
    @apply bg-accent-soft text-accent;
  }

  .nav-icon-link {
    @apply inline-flex size-[2.1rem] items-center justify-center rounded-md border border-line text-muted;
    @apply transition-colors duration-120 ease-[ease];
  }

  .nav-menu-button:hover,
  [open] > .nav-menu-button,
  .nav-icon-link:hover {
    @apply border-accent-border bg-accent-soft text-accent;
  }
</style>
