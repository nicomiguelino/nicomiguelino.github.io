---
import { ClientRouter } from 'astro:transitions';
import SearchOverlay from '@/components/SearchOverlay.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/header/index.astro';
import { DEFAULT_PALETTE } from '@/lib/palette';
import { SITE_NAME, SITE_URL } from '@/lib/site';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
}

const { title, description, canonicalPath = '/', ogType = 'website' } = Astro.props;

const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
const ogImageUrl = new URL('/assets/og.png', SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f0eee9" />
    <link rel="preload" href="/assets/jbm.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline define:vars={{ DEFAULT_PALETTE }}>
      (() => {
        const apply = () => {
          const storedPalette = localStorage.getItem('site-palette');
          const isValidPalette = Object.values(DEFAULT_PALETTE).includes(storedPalette);
          if (storedPalette && !isValidPalette) localStorage.removeItem('site-palette');
          const saved = isValidPalette ? storedPalette : '';
          const system = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? DEFAULT_PALETTE.dark
            : DEFAULT_PALETTE.light;
          document.documentElement.setAttribute('data-palette', saved || system);
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Header />

    <slot />

    <Footer />

    <SearchOverlay />
  </body>
</html>
